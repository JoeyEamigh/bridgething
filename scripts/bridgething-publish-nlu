#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CHANNEL=stable
DRY=0
VERSION=""
BUNDLE_DIR=""
IOS_MODEL=""
ANDROID_MODEL=""
DESKTOP_MODEL=""

log()  { printf '\033[1;36m[publish-nlu]\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[publish-nlu]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[publish-nlu] error:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat >&2 <<EOF
usage: bridgething-publish-nlu --version <ver> --bundle <dir> --ios-model <mlpackage> [options]

  --version <ver>        bundle version to publish
  --bundle <dir>         exported bundle dir (manifest.json + tokenizer.json)
  --ios-model <path>     the .mlpackage directory the ios and macos arms both carry
  --android-model <path> the .tflite the android zip carries (omit to publish ios only)
  --desktop-model <path> the .onnx the linux and windows zip carries (omit to skip both)
  --channel <ch>         default: stable
  --dry-run              digest and print the manifest; upload nothing

Publishing needs an rclone-reachable 'r2' remote plus R2_BUCKET and PUBLIC_BASE.
EOF
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --version) VERSION="${2:?}"; shift 2 ;;
    --bundle) BUNDLE_DIR="${2:?}"; shift 2 ;;
    --ios-model) IOS_MODEL="${2:?}"; shift 2 ;;
    --android-model) ANDROID_MODEL="${2:?}"; shift 2 ;;
    --desktop-model) DESKTOP_MODEL="${2:?}"; shift 2 ;;
    --channel) CHANNEL="${2:?}"; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) usage ;;
    *) die "unknown argument: $1" ;;
  esac
done

[ -n "$VERSION" ] && [ -n "$BUNDLE_DIR" ] && [ -n "$IOS_MODEL" ] || usage
[ -f "$BUNDLE_DIR/manifest.json" ] || die "no manifest.json in $BUNDLE_DIR"
[ -f "$BUNDLE_DIR/tokenizer.json" ] || die "no tokenizer.json in $BUNDLE_DIR"
[ -d "$IOS_MODEL" ] || die "ios model is not an .mlpackage directory: $IOS_MODEL"
[ -z "$ANDROID_MODEL" ] || [ -f "$ANDROID_MODEL" ] || die "no android model at $ANDROID_MODEL"
[ -z "$DESKTOP_MODEL" ] || [ -f "$DESKTOP_MODEL" ] || die "no desktop model at $DESKTOP_MODEL"

PINNED="$REPO_ROOT/crates/nlu/tests/bundle/manifest.json"
cmp -s "$BUNDLE_DIR/manifest.json" "$PINNED" || die "$BUNDLE_DIR/manifest.json differs from the pinned ${PINNED#"$REPO_ROOT"/}.
     copy it over and get nlu_intent_catalog green first, so the label set companions decode ships tested."

digest() { shasum -a 256 "$1" | awk '{print $1}'; }
bytes()  { wc -c <"$1" | tr -d ' '; }

WORK=$(mktemp -d -t bridgething-publish-nlu)
trap 'rm -rf "$WORK"' EXIT

stage_zip() {
  local name="$1"
  local stage="$WORK/$name"
  mkdir -p "$stage"
  cp "$BUNDLE_DIR/manifest.json" "$BUNDLE_DIR/tokenizer.json" "$stage/"
  case "$name" in
    ios)     cp -R "$IOS_MODEL" "$stage/model.mlpackage" ;;
    android) cp "$ANDROID_MODEL" "$stage/model.tflite" ;;
    desktop) cp "$DESKTOP_MODEL" "$stage/model.onnx" ;;
  esac
  find "$stage" -exec touch -t 202601010000 {} +
  ( cd "$stage" && find . -type f | sort | zip -qX "$WORK/bundle-$name.zip" -@ )
  echo "$WORK/bundle-$name.zip"
}

publish_zip() {
  local zip="$1" key="$2" sha live
  sha=$(digest "$zip")
  if [ -n "$(rclone lsf "r2:${R2_BUCKET}/${key}" 2>/dev/null)" ]; then
    live=$(rclone cat "r2:${R2_BUCKET}/${key}" | shasum -a 256 | awk '{print $1}')
    if [ "$live" = "$sha" ]; then
      log "already published, identical bytes: $key"
    else
      die "$key already exists serving ${live:0:12}, and this build is ${sha:0:12}.
     bump the version rather than redefining a published one; every phone pinned to
     it would otherwise silently change meaning."
    fi
  else
    "$REPO_ROOT/scripts/r2-put" "$zip" "$key" application/zip
  fi
}

IOS_ZIP=$(stage_zip ios)
IOS_KEY="nlu/${CHANNEL}/bundle/${VERSION}/bundle-ios.zip"
IOS_SHA=$(digest "$IOS_ZIP"); IOS_SIZE=$(bytes "$IOS_ZIP")
log "ios ${VERSION}  ${IOS_SIZE} bytes  ${IOS_SHA:0:12}"

ANDROID_JSON=null
if [ -n "$ANDROID_MODEL" ]; then
  ANDROID_ZIP=$(stage_zip android)
  ANDROID_KEY="nlu/${CHANNEL}/bundle/${VERSION}/bundle-android.zip"
  ANDROID_SHA=$(digest "$ANDROID_ZIP"); ANDROID_SIZE=$(bytes "$ANDROID_ZIP")
  log "android ${VERSION}  ${ANDROID_SIZE} bytes  ${ANDROID_SHA:0:12}"
  ANDROID_JSON=$(jq -n --arg url "${PUBLIC_BASE:-}/${ANDROID_KEY}" \
    --argjson size "$ANDROID_SIZE" --arg sha256 "$ANDROID_SHA" \
    '{url: $url, size: $size, sha256: $sha256}')
fi

DESKTOP_JSON=null
if [ -n "$DESKTOP_MODEL" ]; then
  DESKTOP_ZIP=$(stage_zip desktop)
  DESKTOP_KEY="nlu/${CHANNEL}/bundle/${VERSION}/bundle-desktop.zip"
  DESKTOP_SHA=$(digest "$DESKTOP_ZIP"); DESKTOP_SIZE=$(bytes "$DESKTOP_ZIP")
  log "desktop ${VERSION}  ${DESKTOP_SIZE} bytes  ${DESKTOP_SHA:0:12}"
  DESKTOP_JSON=$(jq -n --arg url "${PUBLIC_BASE:-}/${DESKTOP_KEY}" \
    --argjson size "$DESKTOP_SIZE" --arg sha256 "$DESKTOP_SHA" \
    '{url: $url, size: $size, sha256: $sha256}')
fi

IOS_JSON=$(jq -n --arg url "${PUBLIC_BASE:-}/${IOS_KEY}" \
  --argjson size "$IOS_SIZE" --arg sha256 "$IOS_SHA" \
  '{url: $url, size: $size, sha256: $sha256}')

MANIFEST="$WORK/manifest.json"
jq -n \
  --arg version "$VERSION" \
  --arg updated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --argjson ios "$IOS_JSON" \
  --argjson android "$ANDROID_JSON" \
  --argjson desktop "$DESKTOP_JSON" \
  '{version: $version, updated_at: $updated_at, ios: $ios, android: $android, macos: $ios,
     linux: $desktop, windows: $desktop}
   | with_entries(select(.value != null))' > "$MANIFEST"

if [ "$DRY" = 0 ]; then
  command -v rclone >/dev/null 2>&1 || die "rclone is not installed"
  : "${R2_BUCKET:?R2_BUCKET is required}"
  : "${PUBLIC_BASE:?PUBLIC_BASE is required}"
  publish_zip "$IOS_ZIP" "$IOS_KEY"
  [ -z "$ANDROID_MODEL" ] || publish_zip "$ANDROID_ZIP" "$ANDROID_KEY"
  [ -z "$DESKTOP_MODEL" ] || publish_zip "$DESKTOP_ZIP" "$DESKTOP_KEY"
  "$REPO_ROOT/scripts/r2-put" "$MANIFEST" "nlu/${CHANNEL}/manifest.json" \
    application/json "public, max-age=300, must-revalidate"
else
  warn "dry run: nothing uploaded"
fi

cat "$MANIFEST"
