#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CHANNEL=stable
DRY=0
MODEL_VERSION=""
RUNTIME_VERSION=""

log()  { printf '\033[1;36m[publish-wakeword]\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[publish-wakeword]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[publish-wakeword] error:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat >&2 <<EOF
usage: bridgething-publish-wakeword --model <ver> [options]

  --model <ver>    phrase model version to publish
  --runtime <ver>  daemon version whose embedding stack this model was trained
                   against; defaults to the workspace version in Cargo.toml
  --channel <ch>   default: stable
  --dry-run        digest and print the fragment; upload nothing

The detector and the embedding stack ride in the daemon, so the phrase model is
the only wake-word artifact that ships on its own. That is also why the release
manifest pairs every model with a runtime version: a phrase model only fires
against the embedding graph it was trained on, and a mismatched pin ships a wake
word that silently never triggers.

Publishing needs rclone configured with an 'r2' remote, plus R2_BUCKET and PUBLIC_BASE.
EOF
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --model) MODEL_VERSION="${2:?}"; shift 2 ;;
    --runtime) RUNTIME_VERSION="${2:?}"; shift 2 ;;
    --channel) CHANNEL="${2:?}"; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) usage ;;
    *) die "unknown argument: $1" ;;
  esac
done

[ -n "$MODEL_VERSION" ] || usage

if [ -z "$RUNTIME_VERSION" ]; then
  RUNTIME_VERSION=$(sed -n '/^\[workspace\.package\]/,/^\[/s/^version = "\([^"]*\)".*/\1/p' \
    "$REPO_ROOT/Cargo.toml" | head -n1)
  [ -n "$RUNTIME_VERSION" ] || die "could not read the workspace version from Cargo.toml; pass --runtime"
fi

MODEL_KEY="wakeword/${CHANNEL}/model/${MODEL_VERSION}/hey_bridgething.btww"
MODEL="$REPO_ROOT/crates/wakeword/models/hey_bridgething.btww"

log "converting the graphs"
"$REPO_ROOT/scripts/bridgething-convert-wakeword" >/dev/null
[ -f "$MODEL" ] || die "no phrase model at $MODEL"

digest() { shasum -a 256 "$1" | awk '{print $1}'; }
bytes()  { wc -c <"$1" | tr -d ' '; }

MODEL_SHA=$(digest "$MODEL"); MODEL_SIZE=$(bytes "$MODEL")
log "model ${MODEL_VERSION}  ${MODEL_SIZE} bytes  ${MODEL_SHA:0:12}"

if [ "$DRY" = 0 ]; then
  command -v rclone >/dev/null 2>&1 || die "rclone is not installed"
  : "${R2_BUCKET:?R2_BUCKET is required}"
  : "${PUBLIC_BASE:?PUBLIC_BASE is required}"

  if [ -n "$(rclone lsf "r2:${R2_BUCKET}/${MODEL_KEY}" 2>/dev/null)" ]; then
    live=$(rclone cat "r2:${R2_BUCKET}/${MODEL_KEY}" 2>/dev/null | shasum -a 256 | awk '{print $1}')
    if [ "$live" = "$MODEL_SHA" ]; then
      log "already published, identical bytes: ${MODEL_KEY}"
    else
      die "${MODEL_KEY} already exists serving ${live:0:12}, and this build is ${MODEL_SHA:0:12}.
     bump the version rather than redefining a published one; every image pinned to
     ${MODEL_KEY##*/} would otherwise silently change meaning."
    fi
  else
    "$REPO_ROOT/scripts/r2-put" "$MODEL" "$MODEL_KEY" application/octet-stream
  fi
else
  warn "dry run: nothing uploaded"
fi

SIDECAR=$(mktemp)
trap 'rm -f "$SIDECAR"' EXIT
cat >"$SIDECAR" <<EOF
{
  "kind": "wakeword-model",
  "channel": "${CHANNEL}",
  "version": "${MODEL_VERSION}",
  "runtime": "${RUNTIME_VERSION}",
  "released_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "artifacts": { "model": { "size": ${MODEL_SIZE}, "sha256": "${MODEL_SHA}" } }
}
EOF

if [ "$DRY" = 0 ]; then
  "$REPO_ROOT/scripts/r2-put" "$SIDECAR" "wakeword/${CHANNEL}/model/${MODEL_VERSION}/release.json" \
    application/json "public, max-age=300, must-revalidate"
fi

cat <<EOF
{
  "wakeword": {
    "runtime": "${RUNTIME_VERSION}",
    "model": "${MODEL_VERSION}",
    "model_trained_against": { "${MODEL_VERSION}": "${RUNTIME_VERSION}" }
  },
  "artifacts": {
    "wakeword": { "model": { "size": ${MODEL_SIZE}, "sha256": "${MODEL_SHA}" } }
  }
}
EOF

log "carry it into the next release with:"
log "  --wakeword-runtime ${RUNTIME_VERSION} \\"
log "  --wakeword-model ${MODEL_VERSION} \\"
log "  --wakeword-trained-against ${MODEL_VERSION}=${RUNTIME_VERSION} \\"
log "  --wakeword-artifact model=${MODEL_SIZE}:${MODEL_SHA}"
log "then 'just pin-wakeword' in yocto-superbird to bake it as the image's floor copy"
