#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ]; then
    cat <<EOF >&2
usage: bridgething-push-webapp <local-path> [<remote-name>]

Copies <local-path> into /var/bridgething/webapps/<name>/ on the device
(default name is the basename of <local-path>), replacing what was there.
EOF
    exit 2
fi

LOCAL="$1"
NAME="${2:-$(basename "$LOCAL")}"

if [ ! -e "$LOCAL" ]; then
    echo "bridgething-push-webapp: local path does not exist: $LOCAL" >&2
    exit 1
fi

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/device.sh"
ROOT="/var/bridgething/webapps"
STAGED=".push.${NAME}"

RECEIVE="set -e; cd ${ROOT}; rm -rf ${STAGED} .old.${NAME}; mkdir -p ${STAGED}; tar -xzf - -C ${STAGED}; if [ -d ${NAME} ]; then mv ${NAME} .old.${NAME}; fi; mv ${STAGED} ${NAME}; rm -rf .old.${NAME}"

tar -czf - -C "${LOCAL%/}" . | $(device_rsh) "root@${DEVICE_HOST}" "$RECEIVE"
