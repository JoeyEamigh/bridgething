#!/usr/bin/env bash
set -euo pipefail

if [ $# -ne 1 ]; then
    cat <<EOF >&2
usage: bridgething-push-daemon <local-path>

Pushes <local-path> to /opt/bridgething/daemon/bridgething.current on the
device while the old daemon keeps running, then rotates .current to
.previous, swaps the new binary in, restarts, and checks the new one is the
one running.
EOF
    exit 2
fi

LOCAL="$1"

if [ ! -x "$LOCAL" ]; then
    echo "bridgething-push-daemon: not an executable file: $LOCAL" >&2
    exit 1
fi

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/device.sh"
DEST_DIR="/opt/bridgething/daemon"
CURRENT="${DEST_DIR}/bridgething.current"
PREVIOUS="${DEST_DIR}/bridgething.previous"
TMP="${DEST_DIR}/bridgething.incoming.$$"

WANT=$(shasum -a 256 "$LOCAL" | awk '{print $1}')

echo "[push-daemon] uploading $(basename "$LOCAL") ($(du -h "$LOCAL" | cut -f1)) to ${DEVICE_HOST}:${TMP}"
device_scp -C -q "$LOCAL" "root@${DEVICE_HOST}:${TMP}"

echo "[push-daemon] swapping it in and restarting bridgething"
device_ssh "
    set -eu
    chmod 0755 ${TMP}
    systemctl stop bridgething.service
    if [ -e ${CURRENT} ]; then
        mv -f ${CURRENT} ${PREVIOUS}
    fi
    mv -f ${TMP} ${CURRENT}
    systemctl reset-failed bridgething.service 2>/dev/null || true
    systemctl start bridgething.service
"

sleep 5
HAVE=$(device_ssh "sha256sum ${CURRENT}" | awk '{print $1}')
if [ "$HAVE" != "$WANT" ]; then
    echo "[push-daemon] the device rolled back to ${HAVE:0:12}; the pushed ${WANT:0:12} did not stay up" >&2
    device_ssh "ls -la ${DEST_DIR}; journalctl -u bridgething -n 30 --no-pager" >&2 || true
    exit 1
fi
if ! device_ssh "systemctl is-active --quiet bridgething.service"; then
    echo "[push-daemon] ${WANT:0:12} is in place but bridgething is not active" >&2
    device_ssh "journalctl -u bridgething -n 30 --no-pager" >&2 || true
    exit 1
fi

echo "[push-daemon] ${WANT:0:12} running."
