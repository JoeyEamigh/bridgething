---
export type Props = {
  refdes?: string;
  class?: string;
  id?: string;
};

const { refdes, class: className, id } = Astro.props;
---

<section id={id} class:list={['relative', className]}>
  <span
    aria-hidden="true"
    class="border-accent bg-bg absolute top-1 -left-7.75 size-2.5 rounded-full border-2 md:-left-13"></span>
  {refdes && <p class="text-accent m-0 mb-6 font-mono text-sm">{refdes}</p>}
  <slot />
</section>
