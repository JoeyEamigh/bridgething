---
import { LAUNCHED } from '../lib/launched';
import { SITE } from '../lib/site';

const path = Astro.url.pathname;
const links: Array<{ href: string; label: string }> = [
  { href: '/install', label: 'install' },
  { href: '/apps', label: 'apps' },
  { href: '/appjam', label: 'app jam' },
  { href: '/device', label: 'device' },
  { href: '/docs', label: 'docs' },
  { href: '/releases', label: 'releases' },
];

const activeHref = links
  .filter(link => path === link.href || path.startsWith(`${link.href}/`))
  .sort((a, b) => b.href.length - a.href.length)[0]?.href;
const isActive = (href: string) => href === activeHref;
---

<header class="bg-bg/80 border-b border-white/10 backdrop-blur-sm">
  <div class="container-site flex flex-wrap items-center justify-between gap-4 py-4">
    <a href="/" class="flex items-center gap-3 border-b-0" aria-label="homepage">
      <img src="/brand/icon-dark.svg" alt="" class="h-5 w-auto shrink-0" />
      <span class="font-mono text-base text-white/80 max-sm:hidden">bridgething</span>
    </a>
    <nav class="flex items-center gap-5 font-mono text-sm text-white/55 max-sm:gap-3">
      {
        links.map(link => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={['border-b-0', isActive(link.href) ? 'text-off-white' : 'hover:text-off-white']}>
            {link.label}
          </a>
        ))
      }
      {
        LAUNCHED ? (
          <a href={SITE.repo} class="hover:text-off-white border-b-0">
            github
          </a>
        ) : (
          <span class="text-white/35">github (coming soon)</span>
        )
      }
    </nav>
  </div>
</header>
