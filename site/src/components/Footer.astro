---
import { SITE } from '../lib/site';

const now = new Date();
const rev = `${now.getFullYear()}.${String(now.getMonth() + 1).padStart(2, '0')}`;

const cells: Array<{ label: string; value: string; href?: string }> = [
  { label: 'title', value: 'bridgething' },
  { label: 'rev', value: rev },
  { label: 'drawn by', value: 'the community' },
  { label: 'discord', value: 'tl.mt/d', href: SITE.discord },
  { label: 'notes', value: 'not affiliated with spotify' },
];
---

<footer class="container-site w-full pb-16">
  <div class="grid grid-cols-2 border-t border-l border-white/25 font-mono text-sm md:grid-cols-5">
    {
      cells.map(cell => (
        <div class="flex flex-col gap-1 border-r border-b border-white/25 p-4 max-md:last:col-span-2">
          <span class="text-xs text-white/40">{cell.label}</span>
          {cell.href ? (
            <a href={cell.href} class="text-white/80" rel="noreferrer noopener">
              {cell.value}
            </a>
          ) : (
            <span class="text-white/80 tabular-nums">{cell.value}</span>
          )}
        </div>
      ))
    }
  </div>
</footer>
