---
import InstallCTA from '../../components/InstallCTA.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';

const refdes = 'text-accent m-0 mb-4 font-mono text-sm font-normal tracking-normal';
---

<DocsLayout
  title="getting started"
  current="getting-started"
  description="installing bridgething on a spotify car thing and pairing it to your phone.">
  <header class="mb-14">
    <h1>getting started</h1>
    <p class="text-white/60">install it over usb, then run it from your phone.</p>
  </header>

  <section class="mb-14">
    <h2 class={refdes}>d1 - install</h2>
    <p class="text-white/60">
      you need a usb-c cable, chrome, and an iphone or android phone. plug the car thing into your computer and start
      the installer.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-4">
      <InstallCTA channel="stable" label="install" variant="primary" size="lg" />
      <a href="/releases" class="btn">release notes</a>
    </div>
  </section>

  <section class="mb-14">
    <h2 class={refdes}>d2 - pair</h2>
    <p class="text-white/60">
      the car thing shows its own name when it boots. open the bridgething app on your phone and pick that name.
      updates, settings, and new apps come through the companion app.
    </p>
    <img
      src="/screenshots/companion-home.png"
      alt="the companion app connected to a device"
      loading="lazy"
      class="mt-6 w-full max-w-64 border border-white/15"
    />
  </section>

  <section>
    <h2 class={refdes}>d3 - apps</h2>
    <p class="text-white/60">
      a launcher, spotify's interface, and a browser ship with it. calendar, weather, home assistant, and the rest are
      in the <a href="/apps">catalog</a>.
    </p>
  </section>
</DocsLayout>
