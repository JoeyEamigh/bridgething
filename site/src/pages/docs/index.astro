---
import DocsLayout from '../../layouts/DocsLayout.astro';

const refdes = 'text-accent m-0 mb-4 font-mono text-sm font-normal tracking-normal';

const using = [
  { href: '/docs/getting-started', label: 'getting started', body: 'install it and pair your phone' },
  { href: '/docs/faq', label: 'faq', body: 'what works and what you can undo' },
  { href: '/docs/troubleshooting', label: 'troubleshooting', body: 'fixes for what goes wrong' },
];

const building = [
  { href: '/docs/sdk', label: 'webapp sdk', body: 'the typed client your webapp uses to talk to the device' },
  {
    href: '/docs/settings-pages',
    label: 'settings pages',
    body: 'a settings screen for your webapp, in the companion app',
  },
  {
    href: '/docs/extensions',
    label: 'extensions',
    body: 'a desktop process your webapp can talk to',
  },
  {
    href: '/docs/launchers-and-overlays',
    label: 'launchers and overlays',
    body: 'your own home screen or system overlay',
  },
  { href: '/docs/publishing-apps', label: 'publishing apps', body: 'host a source, get listed' },
];
---

<DocsLayout title="docs" description="how to install, use, and build for bridgething on the spotify car thing.">
  <header class="mb-14">
    <h1>docs</h1>
    <p class="text-white/60">
      bridgething replaces spotify's software on the car thing with a linux system, a launcher, and whatever apps you
      put on it.
    </p>
  </header>

  <section class="mb-14">
    <h2 class={refdes}>d1 - using it</h2>
    <ul role="list" class="m-0 grid list-none grid-cols-1 border-t border-l border-white/10 p-0 sm:grid-cols-3">
      {
        using.map(item => (
          <li class="bg-bg flex border-r border-b border-white/10">
            <a href={item.href} class="flex flex-col gap-2 border-b-0 p-5 hover:bg-white/4">
              <span class="font-display text-base font-medium">{item.label}</span>
              <span class="font-mono text-sm text-pretty text-white/50">{item.body}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-14">
    <h2 class={refdes}>d2 - building apps</h2>
    <p class="mb-6 text-white/60">
      a webapp is a web page that runs full screen on the device, with the connected phone's internet to work with.
    </p>
    <ul role="list" class="m-0 grid list-none grid-cols-1 border-t border-l border-white/10 p-0 sm:grid-cols-2">
      {
        building.map(item => (
          <li class="bg-bg flex border-r border-b border-white/10">
            <a href={item.href} class="flex flex-col gap-2 border-b-0 p-5 hover:bg-white/4">
              <span class="font-display text-base font-medium">{item.label}</span>
              <span class="font-mono text-sm text-pretty text-white/50">{item.body}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</DocsLayout>
