---
import Snippet from '../../components/docs/Snippet.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { methodCount, surfaceHasMethods } from '../../lib/docs.ts';
import { renderMdInline } from '../../lib/md.ts';
import { loadSurfaceDocs } from '../../lib/sdk.ts';
import { SITE } from '../../lib/site.ts';

const docs = await loadSurfaceDocs();
const surfaces = docs.surfaces.filter(surfaceHasMethods).sort((a, b) => a.title.localeCompare(b.title));

function blurb(description?: string): string {
  if (!description) return '';
  const flat = description.replace(/\s+/g, ' ').trim();
  const end = flat.search(/\.\s/);
  return end === -1 ? flat : flat.slice(0, end + 1);
}

const refdes = 'text-accent m-0 mb-4 font-mono text-sm font-normal tracking-normal';

const connectSnippet = `import { BridgethingClient } from '@bridgething/client';

const client = new BridgethingClient(); // auto-connects, auto-reconnects`;

const resultShape = `type TypedRequestResult<Response, Error> =
  | { ok: true; response: Response }
  | { ok: false; kind: 'domain'; error: Error }
  | { ok: false; kind: 'protocol'; error: WireError };`;

const wireErrorShape = `type WireError =
  | { type: 'unsupported' }
  | { type: 'unimplemented' }
  | { type: 'malformed'; data: { reason: string } }
  | { type: 'handlerFailed'; data: { reason: string } };`;

const overlayOptOut = `{
  "overlays": { "volume": false }
}`;

const voiceActivity = `client.voice.onActivity(a => {
  // a.phase     'idle' | 'listening' | 'thinking' | 'done' | 'failed'
  // a.transcript the recognized text, once there is one
  // a.intent     the resolved intent name, e.g. 'PAUSE'
  // a.slots      its parsed arguments
  // a.stage      'fastPath' | 'model' | 'rejectedNoIntent' | 'rejectedClarify' | 'noModel'
  // a.target     'playback' | 'device' | 'phone' | 'display' | 'webappSwitch'
  // a.error      { code, msg } when the turn ended without dispatching
  render(a);
});`;

const voiceIntent = `client.voice.onIntent(i => {
  // the spoken words are i.transcript. i.slots.target is the entity the nlu
  // found in them, when it found one.
  if (i.intent === 'search') return showSearch(i.slots.target ?? i.transcript, i.slots.targetType);
  if (i.intent === 'showView') return navigate(i.slots.view);
  if (i.intent === 'moreLikeThis') return showSimilar(i.slots);
});`;

const voiceManifest = `{
  "rendersVoiceDisplay": true
}`;

const voiceControls = `await client.voice.pushToTalk(); // start a turn
await client.voice.release();    // stop capturing, let the turn finish
await client.voice.cancel();     // drop the turn

await client.voice.muteMic({ preserve: true });
await client.voice.unmuteMic({ preserve: true });

const res = await client.voice.stateGet();
client.voice.onStateChanged(s => setMic(s.muted, s.capturing, s.phase));`;

type Row = {
  surface: string;
  ios: boolean;
  android: boolean;
  macos: boolean;
  linux: boolean;
  windows: boolean;
  note?: string;
};

const availability: Row[] = [
  { surface: 'asset', ios: true, android: true, macos: true, linux: true, windows: true },
  { surface: 'audio', ios: true, android: true, macos: true, linux: true, windows: true },
  { surface: 'bluetooth', ios: true, android: true, macos: true, linux: true, windows: true },
  { surface: 'capabilities', ios: true, android: true, macos: true, linux: true, windows: true },
  { surface: 'config', ios: true, android: true, macos: true, linux: true, windows: true },
  { surface: 'doc', ios: true, android: true, macos: true, linux: true, windows: true },
  {
    surface: 'forward',
    ios: false,
    android: false,
    macos: true,
    linux: true,
    windows: true,
    note: '<code>available.forward</code> is true while an extension for the active webapp is running.',
  },
  {
    surface: 'geo',
    ios: true,
    android: true,
    macos: true,
    linux: true,
    windows: true,
    note: '<code>available.geo</code> reflects the location grant on the companion.',
  },
  { surface: 'hardware', ios: true, android: true, macos: true, linux: true, windows: true },
  {
    surface: 'library',
    ios: true,
    android: true,
    macos: true,
    linux: true,
    windows: true,
    note: 'spotify everywhere, apple music on ios. <code>capabilities.musicProvider</code> names the one in use.',
  },
  {
    surface: 'lyrics',
    ios: true,
    android: true,
    macos: true,
    linux: true,
    windows: true,
    note: 'resolves through the music provider, so a lookup can answer <code>notSupported</code>.',
  },
  { surface: 'net', ios: true, android: true, macos: true, linux: true, windows: true },
  {
    surface: 'notifications',
    ios: true,
    android: true,
    macos: false,
    linux: true,
    windows: false,
    note: 'ancs on ios, the notification listener on android, freedesktop on linux.',
  },
  { surface: 'peer', ios: true, android: true, macos: true, linux: true, windows: true },
  {
    surface: 'phone',
    ios: true,
    android: true,
    macos: false,
    linux: false,
    windows: false,
  },
  {
    surface: 'player',
    ios: true,
    android: true,
    macos: true,
    linux: true,
    windows: true,
    note: '<code>transferTo</code> needs <code>available.playbackTargets</code>, which depends on the music provider.',
  },
  { surface: 'store', ios: true, android: true, macos: true, linux: true, windows: true },
  { surface: 'system', ios: true, android: true, macos: true, linux: true, windows: true },
  { surface: 'time', ios: true, android: true, macos: true, linux: true, windows: true },
  {
    surface: 'voice',
    ios: true,
    android: true,
    macos: true,
    linux: true,
    windows: true,
    note: 'a turn resolves with <code>stage: noModel</code> until the companion has the voice model installed.',
  },
  { surface: 'webapp', ios: true, android: true, macos: true, linux: true, windows: true },
];

const platforms = ['ios', 'android', 'macos', 'linux', 'windows'] as const;

const shapes = [
  {
    label: 'events',
    body: 'the daemon pushes, you subscribe.',
    code: `const off = client.player.onSnapshot(r => render(r.state));
off(); // stop listening`,
  },
  {
    label: 'requests',
    body: 'you ask, the daemon answers with a tagged result.',
    code: `const res = await client.player.stateGet();
if (res.ok) render(res.response.state);`,
  },
  {
    label: 'commands',
    body: 'resolves once the daemon has the message.',
    code: `await client.player.skipNext();`,
  },
];
---

<DocsLayout
  title="webapp sdk"
  current="sdk"
  description="reference for @bridgething/client, the sdk a car thing webapp uses to talk to the on-device daemon.">
  <header class="mb-12">
    <h1>webapp sdk</h1>
    <p class="text-white/60">
      a webapp is one page in the car thing's kiosk. it reaches the daemon through one typed client,
      <a href="https://www.npmjs.com/package/@bridgething/client">@bridgething/client</a>.
    </p>
  </header>

  <section class="mb-14">
    <h2 class={refdes}>d1 - start a project</h2>
    <p class="text-white/60">react, vite, tailwind, and this client come preinstalled.</p>
    <Snippet code="bun create bridgething my-app" lang="bash" />
    <ul role="list" class="mt-4 space-y-1.5 text-sm text-white/60">
      <li>
        <code class="text-white/80">--launcher</code> scaffolds a home screen for the device's launcher slot. see
        <a href="/docs/launchers-and-overlays">launchers and overlays</a>.
      </li>
      <li>
        <code class="text-white/80">--overlay</code> scaffolds a system overlay, drawn over every webapp.
      </li>
      <li>
        <code class="text-white/80">--extension</code> adds a deno process on the desktop. combines with either. see
        <a href="/docs/extensions">extensions</a>.
      </li>
      <li><code class="text-white/80">--no-install</code>, <code class="text-white/80">--no-git</code></li>
    </ul>
    <p class="mt-4 text-white/60">
      every system overlay is on by default. turn one off in the manifest when you draw it yourself.
    </p>
    <Snippet code={overlayOptOut} lang="json" />
    <p class="mt-3 text-sm text-white/45">
      source and issues on <a href={`${SITE.github}/bridgething`}>github</a>.
    </p>
  </section>

  <section class="mb-14">
    <h2 class={refdes}>d2 - settings pages and extensions</h2>
    <p class="text-white/60">
      a <strong class="text-white/80"><a href="/docs/settings-pages">settings page</a></strong> is one html file in your bundle
      that the companion app or the desktop app renders, with its own sdk for config,
      <a href="/docs/settings-pages#fetch">fetch</a>, and <a href="/docs/settings-pages#auth">oauth</a>.
    </p>
    <p class="mt-4 text-white/60">
      an <strong class="text-white/80"><a href="/docs/extensions">extension</a></strong> is a deno process the desktop app
      runs for your webapp, with host access. your webapp reaches it over <code>client.forward</code>.
    </p>
  </section>

  <section class="mb-14">
    <h2 class={refdes}>d3 - connect</h2>
    <p class="text-white/60">construct the client once and reuse it.</p>
    <Snippet code={connectSnippet} />
  </section>

  <section class="mb-16">
    <h2 class={refdes}>d4 - the three call shapes</h2>
    {
      shapes.map(s => (
        <div class="mb-6">
          <h3 class="font-display m-0 text-base font-medium">{s.label}</h3>
          <p class="mt-1 mb-2 text-sm text-white/60">{s.body}</p>
          <Snippet code={s.code} />
        </div>
      ))
    }
  </section>

  <section class="mb-16 scroll-mt-24" id="request-results">
    <h2 class={refdes}>d5 - request results</h2>
    <p class="text-white/60">
      a request resolves to a tagged result. narrow it on <code>ok</code>.
    </p>
    <Snippet code={resultShape} />
    <ul role="list" class="mt-4 space-y-1.5 text-sm text-white/60">
      <li>
        <code class="text-white/80">kind</code> is <code>'domain'</code> for a failure the operation defines, such as an asset
        that is missing, or <code>'protocol'</code> when the daemon could not dispatch the request.
      </li>
    </ul>
    <p class="mt-4 text-sm text-white/60">
      every request also accepts an optional second argument <code>{'{ timeoutMs }'}</code>.
    </p>
    <Snippet code={wireErrorShape} />
  </section>

  <section class="mb-16 scroll-mt-24" id="availability">
    <h2 class={refdes}>d6 - what is available where</h2>
    <p class="text-white/60">some surfaces depend on the connected companion app, and companions differ.</p>
    <p class="mt-4 text-white/60">
      branch on <code>client.capabilities</code>, which reports what the connected companion supplies.
    </p>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full border-collapse font-mono text-sm">
        <thead>
          <tr class="border-b border-white/20 text-left text-white/45">
            <th class="py-3 pr-4 font-normal whitespace-nowrap">surface</th>
            {platforms.map(p => <th class="py-3 pr-4 font-normal whitespace-nowrap">{p}</th>)}
            <th class="py-3 font-normal">notes</th>
          </tr>
        </thead>
        <tbody class="text-white/70">
          {
            availability.map(row => (
              <tr class="border-b border-white/10">
                <td class="py-3 pr-4 align-top whitespace-nowrap">
                  <a href={`/docs/${row.surface}`}>{row.surface}</a>
                </td>
                {platforms.map(p => (
                  <td class:list={['py-3 pr-4 align-top', row[p] ? 'text-accent' : 'text-white/25']}>
                    {row[p] ? 'yes' : 'no'}
                  </td>
                ))}
                <td class="py-3 align-top text-white/50" set:html={row.note ?? ''} />
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-white/45">
      macos, linux, and windows are the bridgething desktop app. ios and android are the companion phone app.
    </p>
  </section>

  <section class="mb-16 scroll-mt-24" id="voice">
    <h2 class={refdes}>d7 - voice</h2>
    <p class="text-white/60">the companion app transcribes the mic and resolves an intent. the daemon dispatches it.</p>
    <Snippet code={voiceActivity} />

    <h3 class="font-display mt-8 mb-1 text-base font-medium">display intents</h3>
    <p class="text-white/60">
      the daemon hands three intents to the active webapp to draw: <code>search</code>, <code>showView</code>, and
      <code>moreLikeThis</code>.
    </p>
    <Snippet code={voiceIntent} />
    <p class="mt-3 text-white/60">
      declare <code>rendersVoiceDisplay</code> in your manifest to receive them. otherwise the turn fails with
      <code>error.code: 'notDispatchable'</code>.
    </p>
    <Snippet code={voiceManifest} lang="json" />

    <h3 class="font-display mt-8 mb-1 text-base font-medium">driving the mic</h3>
    <Snippet code={voiceControls} />
    <p class="mt-3 text-sm text-white/60">
      <code>preserve</code> keeps the mute in place after the turn ends. see
      <a href="/docs/voice">client.voice</a> for the full signatures.
    </p>
  </section>

  <section>
    <div class="mb-1 border-b border-white/20 pb-2">
      <h2 class={refdes.replace('mb-4', 'mb-1')}>d8 - surfaces</h2>
      <p class="m-0 font-mono text-sm text-white/45">{surfaces.length} surfaces on <code>client.&lt;name&gt;</code></p>
    </div>
    {
      surfaces.map(s => (
        <a href={`/docs/${s.name}`} class="group block border-t border-white/10 py-4 first:border-t-0 hover:border-b-0">
          <div class="flex items-baseline justify-between gap-4">
            <span class="font-display group-hover:text-accent text-lg font-medium transition-colors">
              {s.title.toLowerCase()}
            </span>
            <span class="font-mono text-xs text-white/40">{methodCount(s)} methods</span>
          </div>
          <code class="text-accent text-xs">client.{s.name}</code>
          {s.description && (
            <p class="mt-1.5 mb-0 text-sm text-white/60" set:html={renderMdInline(blurb(s.description))} />
          )}
        </a>
      ))
    }
  </section>
</DocsLayout>
