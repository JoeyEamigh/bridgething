{
  "name": "@bridgething/site",
  "private": true,
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "bun run manifest:build && bun run sdk:build && astro build",
    "catalog:build": "bun run apps/build.ts",
    "deploy": "bun run build && wrangler deploy",
    "dev": "astro dev",
    "format": "prettier --write \"**/*.{ts,tsx,css,astro}\"",
    "manifest:build": "bun run manifest/build.ts",
    "preview": "astro preview",
    "sdk:build": "bun run sdk/build.ts",
    "shell-fs:build": "bun run scripts/build-shell-fs.ts",
    "test": "bun test",
    "typecheck": "astro check && tsc --noEmit && tsc --noEmit -p worker"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/preact": "5.1.5",
    "@astrojs/sitemap": "^3.7.3",
    "@bridgething/browser": "workspace:*",
    "@bridgething/catalog": "workspace:*",
    "@bridgething/client": "workspace:*",
    "@bridgething/companion-types": "workspace:*",
    "@bridgething/lib": "workspace:*",
    "@bridgething/ui": "workspace:*",
    "@preact/signals": "^2.10.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^6.3.1",
    "fflate": "^0.8.3",
    "flashthing-wasm": "^0.5.0",
    "gray-matter": "^4.0.3",
    "just-bash": "^3.1.0",
    "marked": "^18.0.3",
    "preact": "^10.29.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/bun": "^1.3.13",
    "@types/w3c-web-usb": "^1.0.14",
    "happy-dom": "^20.11.15",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prettier-plugin-tailwindcss-canonical-classes": "^0.1.4",
    "vite": "^7.3.2",
    "wrangler": "^4.90.0"
  }
}
