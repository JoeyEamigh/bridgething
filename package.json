{
  "name": "turbo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "publish:packages": "bun scripts/publish-packages.ts",
    "mobile": "cd mobile && bun run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bun": "^1.3.13",
    "eslint": "^9.39.4",
    "globals": "^17.8.0",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.8",
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-is": "19.2.3",
    "react-native-nitro-modules": "0.35.5"
  },
  "workspaces": [
    "crates/lib",
    "crates/companion",
    "crates/delivery/napi",
    "packages/*",
    "packages/webapps/builtin/*",
    "packages/webapps/catalog/*",
    "mobile",
    "site",
    "desktop"
  ],
  "patchedDependencies": {
    "react-native-nitro-modules@0.35.5": "patches/react-native-nitro-modules@0.35.5.patch",
    "react-native-worklets@0.8.3": "patches/react-native-worklets@0.8.3.patch"
  }
}
