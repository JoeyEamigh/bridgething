{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["RUSTUP_HOME", "RUSTUP_TOOLCHAIN", "CARGO_HOME"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "native/**", "lib/**"]
    },
    "nitro:codegen": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "nitro.json", "package.json"],
      "outputs": ["nitrogen/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "ts/**",
        "scripts/**",
        "test/**",
        "dev/**",
        "eslint.config.*",
        "tsconfig*.json",
        "package.json",
        "components/**",
        "screens/**",
        "lib/**",
        "__tests__/**",
        "__mocks__/**",
        "*.tsx",
        "*.ts"
      ],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@bridgething/browser#typecheck": {
      "dependsOn": ["@bridgething/browser#build"],
      "inputs": ["src/**", "tsconfig*.json", "package.json"],
      "outputs": []
    },
    "@bridgething/lib#build": {
      "dependsOn": ["^build"],
      "inputs": ["ts/**", "scripts/**", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "@bridgething/lib#typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["ts/**", "tsconfig*.json", "package.json"],
      "outputs": []
    },
    "@bridgething/companion-types#typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["ts/**", "tsconfig*.json", "package.json"],
      "outputs": []
    },
    "@bridgething/companion-types#build": {
      "dependsOn": ["^build"],
      "inputs": ["ts/**", "package.json"],
      "outputs": []
    },
    "@bridgething/core-node#build": {
      "dependsOn": ["^build"],
      "inputs": ["index.js", "index.d.ts", "package.json"],
      "outputs": []
    },
    "@bridgething/desktop-frontend#typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!src-tauri/**"],
      "outputs": []
    },
    "@bridgething/desktop-frontend#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!src-tauri/**"],
      "outputs": []
    }
  }
}
