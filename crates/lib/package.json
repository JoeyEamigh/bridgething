{
  "name": "@bridgething/lib",
  "version": "0.12.1",
  "description": "Wire types and shared constants for bridgething, the community daemon that replaces Spotify's app on the Car Thing.",
  "license": "MIT",
  "author": "Joey Eamigh <55670930+JoeyEamigh@users.noreply.github.com> (https://github.com/JoeyEamigh)",
  "homepage": "https://bridgething.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeyEamigh/bridgething.git",
    "directory": "crates/lib"
  },
  "bugs": {
    "url": "https://github.com/JoeyEamigh/bridgething/issues"
  },
  "keywords": [
    "bridgething",
    "spotify",
    "car-thing",
    "superbird",
    "wire-protocol"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/bindings/client.d.ts",
      "default": "./dist/bindings/client.js"
    },
    "./gateway": {
      "types": "./dist/bindings/gateway.d.ts",
      "default": "./dist/bindings/gateway.js"
    },
    "./shared": {
      "types": "./dist/bindings/shared.d.ts",
      "default": "./dist/bindings/shared.js"
    },
    "./stock": {
      "types": "./dist/bindings/stock.d.ts",
      "default": "./dist/bindings/stock.js"
    },
    "./wire": {
      "types": "./dist/bindings/wire.d.ts",
      "default": "./dist/bindings/wire.js"
    },
    "./uuid": {
      "types": "./dist/uuid.d.ts",
      "default": "./dist/uuid.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "bun run version && rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "version": "bun run gv && bun run ./scripts/set-version.ts",
    "gv": "genversion --esm --semi ts/version.ts"
  },
  "devDependencies": {
    "@types/uuid": "^11.0.0",
    "genversion": "3.2.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "uuid": "^14.0.0"
  }
}
