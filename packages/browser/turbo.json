{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/crates/delivery/wasm/**",
        "$TURBO_ROOT$/crates/delivery/core/**",
        "$TURBO_ROOT$/crates/gateway-rs/**",
        "$TURBO_ROOT$/crates/io/**",
        "$TURBO_ROOT$/crates/lib/**",
        "$TURBO_ROOT$/crates/sdk-runtime/**"
      ],
      "outputs": ["dist/**", "wasm/**"]
    }
  }
}
