    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.3",
    "preact": "^11.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.21.10",
