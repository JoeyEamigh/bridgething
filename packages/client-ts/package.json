{
  "name": "@bridgething/client",
  "version": "0.15.1",
  "description": "Typed client SDK a bridgething webapp uses to talk to the on-device daemon on a Spotify Car Thing.",
  "license": "MIT",
  "author": "Joey Eamigh <55670930+JoeyEamigh@users.noreply.github.com> (https://github.com/JoeyEamigh)",
  "homepage": "https://bridgething.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeyEamigh/bridgething.git",
    "directory": "packages/client-ts"
  },
  "bugs": {
    "url": "https://github.com/JoeyEamigh/bridgething/issues"
  },
  "keywords": [
    "bridgething",
    "spotify",
    "car-thing",
    "superbird",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "default": "./dist/settings.js"
    },
    "./settings-protocol": {
      "types": "./dist/settings-protocol.d.ts",
      "default": "./dist/settings-protocol.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "default": "./dist/form.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./default-settings": {
      "types": "./dist/default-settings.d.ts",
      "default": "./dist/default-settings.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json && vite build -c vite.default-settings.config.ts",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test"
  },
  "dependencies": {
    "@bridgething/lib": "workspace:*",
    "@msgpack/msgpack": "^3.1.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.3",
    "preact": "^11.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
