{
  "id": "01a04f27-8595-7000-89de-891e682b3c40",
  "name": "System Info",
  "version": "0.12.1",
  "description": "Load, memory, and uptime of the computer running the desktop app.",
  "icon": "icon.svg",
  "permissions": [],
  "extension": {
    "entry": "extension/desktop.mjs",
    "permissions": [
      "sys:hostname",
      "sys:osRelease",
      "sys:osUptime",
      "sys:loadavg",
      "sys:systemMemoryInfo",
      "sys:networkInterfaces",
      "sys:cpus",
      "run:vm_stat",
      "read:/proc/meminfo"
    ],
    "api": 1
  }
}
